# SMTP (SendLayer SMTP or compatible). Existing names reused by sendSmtpMail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME=Petrosphere Training
SMTP_FROM_EMAIL=
# Optional aliases also accepted: SMTP_FROM, MAIL_FROM, SMTP_FROM_EMAIL_ADDRESS

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for webhook registration script)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# SendLayer Events API + optional webhook registration script (server-only)
SENDLAYER_API_KEY=

# Protects GET /api/email-status and POST /api/email-status/reconcile via Authorization: Bearer
# (authenticated Supabase session cookies also work for the admin UI)
EMAIL_STATUS_ADMIN_TOKEN=

# Optional: force file-backed tracking store (dev only; not durable on Vercel)
# EMAIL_TRACKING_STORE=file
